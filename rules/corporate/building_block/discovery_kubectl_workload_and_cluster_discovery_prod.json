{
    "attributes": {
        "author": [
            "Acme Security Engineering"
        ],
        "building_block_type": "default",
        "description": "This rule detects the execution of kubectl commands that are commonly used for workload and cluster discovery in Kubernetes environments. It looks for process events where kubectl is executed with arguments that query cluster information, such as namespaces, nodes, pods, deployments, and other resources. In environments where kubectl is not expected to be used, this could indicate potential reconnaissance activity by an adversary. Tuned for the Acme Corporate IT production environment.",
        "from": "now-119m",
        "index": [
            "acme-corporate-prod-logs-endpoint.events.*",
            "acme-corporate-prod-endgame-*",
            "acme-corporate-prod-auditbeat-*",
            "acme-corporate-prod-logs-auditd_manager.auditd-*",
            "acme-corporate-prod-logs-crowdstrike.fdr*",
            "acme-corporate-prod-logs-cloud_defend.process*"
        ],
        "interval": "60m",
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Acme Corporate IT (Production): Kubectl Workload and Cluster Discovery",
        "query": "process where host.os.type == \"linux\" and event.type == \"start\" and\nevent.action in (\"exec\", \"exec_event\", \"executed\", \"process_started\", \"ProcessRollup2\") and\nprocess.name == \"kubectl\" and (\n  (process.args in (\"cluster-info\", \"api-resources\", \"api-versions\", \"version\")) or\n  (process.args in (\"get\", \"describe\") and process.args in (\n    \"namespaces\", \"nodes\", \"pods\", \"pod\", \"deployments\", \"deployment\",\n    \"replicasets\", \"statefulsets\", \"daemonsets\", \"services\", \"service\",\n    \"ingress\", \"ingresses\", \"endpoints\", \"configmaps\", \"events\", \"svc\",\n    \"roles\", \"rolebindings\", \"clusterroles\", \"clusterrolebindings\"\n    )\n  )\n)\n",
        "related_integrations": [
            {
                "package": "endpoint",
                "version": ">=9.0.0"
            },
            {
                "package": "auditd_manager",
                "version": ">=1.18.0"
            },
            {
                "package": "crowdstrike",
                "version": ">=3.0.0"
            },
            {
                "package": "cloud_defend",
                "version": ">=1.4.0"
            }
        ],
        "required_fields": [
            {
                "ecs": true,
                "name": "event.action",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "event.type",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "host.os.type",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "process.args",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "process.name",
                "type": "keyword"
            }
        ],
        "risk_score": 21,
        "rule_id": "c91a0956-9706-5c27-aea4-82bf7f9c0e7d",
        "severity": "low",
        "tags": [
            "Domain: Containers",
            "Domain: Endpoint",
            "Domain: Kubernetes",
            "OS: Linux",
            "Use Case: Threat Detection",
            "Tactic: Discovery",
            "Rule Type: BBR",
            "Data Source: Elastic Defend",
            "Data Source: Elastic Endgame",
            "Data Source: Auditd Manager",
            "Data Source: Crowdstrike",
            "Data Source: Elastic Defend for Containers",
            "Rule Type: Event Correlation (EQL)",
            "Platform: Linux",
            "Platform: Kubernetes",
            "Acme Business Unit: Corporate IT",
            "Acme Environment: Production",
            "Source: Acme Rules Library"
        ],
        "threat": [
            {
                "framework": "MITRE ATT&CK",
                "tactic": {
                    "id": "TA0007",
                    "name": "Discovery",
                    "reference": "https://attack.mitre.org/tactics/TA0007/"
                },
                "technique": [
                    {
                        "id": "T1069",
                        "name": "Permission Groups Discovery",
                        "reference": "https://attack.mitre.org/techniques/T1069/"
                    },
                    {
                        "id": "T1613",
                        "name": "Container and Resource Discovery",
                        "reference": "https://attack.mitre.org/techniques/T1613/"
                    }
                ]
            }
        ],
        "timestamp_override": "event.ingested",
        "type": "eql",
        "version": 1
    },
    "id": "c91a0956-9706-5c27-aea4-82bf7f9c0e7d_1",
