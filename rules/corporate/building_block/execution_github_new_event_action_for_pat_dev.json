            "Tactic: Execution",
            "Rule Type: BBR",
            "Data Source: Github",
            "Rule Type: New Terms",
            "Platform: GitHub",
            "Domain: SaaS",
            "Tactic: Lateral Movement",
            "Tactic: Persistence",
            "Acme Business Unit: Corporate IT",
            "Acme Environment: Development",
            "Source: Acme Rules Library"
        ],
