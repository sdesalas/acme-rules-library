{
    "attributes": {
        "author": [
            "Acme Security Engineering"
        ],
        "building_block_type": "default",
        "description": "Identifies an unsigned Windows Background Intelligent Transfer Service (BITS) client process. Attackers may abuse BITS functionality to download or upload data using the BITS service. Tuned for the Acme Corporate IT development environment.",
        "from": "now-119m",
        "index": [
            "acme-corporate-dev-logs-endpoint.events.library-*"
        ],
        "interval": "60m",
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Acme Corporate IT (Development): Unsigned BITS Service Client Process",
        "query": "library where dll.name : \"Bitsproxy.dll\" and process.executable != null and\nnot process.code_signature.trusted == true and\nnot process.code_signature.status : (\"errorExpired\", \"errorCode_endpoint*\")\n",
        "references": [
            "https://web.archive.org/web/20230531215706/https://blog.menasec.net/2021/05/hunting-for-suspicious-usage-of.html",
            "https://www.elastic.co/blog/hunting-for-persistence-using-elastic-security-part-2"
        ],
        "related_integrations": [
            {
                "package": "endpoint",
                "version": ">=9.0.0"
            }
        ],
        "required_fields": [
            {
                "ecs": true,
                "name": "dll.name",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "process.code_signature.status",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "process.code_signature.trusted",
                "type": "boolean"
            },
            {
                "ecs": true,
                "name": "process.executable",
                "type": "keyword"
            }
        ],
        "risk_score": 21,
        "rule_id": "0ae5ca23-dbc8-5f0f-950b-61a20a3bd3bd",
        "severity": "low",
        "tags": [
            "Domain: Endpoint",
            "OS: Windows",
            "Use Case: Threat Detection",
            "Rule Type: BBR",
            "Data Source: Elastic Defend",
            "Rule Type: Event Correlation (EQL)",
            "Platform: Windows",
            "Tactic: Stealth",
            "Acme Business Unit: Corporate IT",
            "Acme Environment: Development",
            "Source: Acme Rules Library"
        ],
        "threat": [
            {
                "framework": "MITRE ATT&CK",
                "tactic": {
                    "id": "TA0005",
                    "name": "Stealth",
                    "reference": "https://attack.mitre.org/tactics/TA0005/"
                },
                "technique": [
                    {
                        "id": "T1036",
                        "name": "Masquerading",
                        "reference": "https://attack.mitre.org/techniques/T1036/",
                        "subtechnique": [
                            {
                                "id": "T1036.001",
                                "name": "Invalid Code Signature",
                                "reference": "https://attack.mitre.org/techniques/T1036/001/"
                            }
                        ]
                    },
                    {
                        "id": "T1197",
                        "name": "BITS Jobs",
                        "reference": "https://attack.mitre.org/techniques/T1197/"
                    }
                ]
            }
        ],
        "timestamp_override": "event.ingested",
        "type": "eql",
        "version": 1
    },
