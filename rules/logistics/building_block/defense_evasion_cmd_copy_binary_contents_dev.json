{
    "attributes": {
        "author": [
            "Acme Security Engineering"
        ],
        "building_block_type": "default",
        "description": "Attackers may abuse cmd.exe commands to reassemble binary fragments into a malicious payload. Tuned for the Acme Logistics development environment.",
        "from": "now-119m",
        "index": [
            "acme-logistics-dev-endgame-*",
            "acme-logistics-dev-logs-endpoint.events.process-*",
            "acme-logistics-dev-logs-system.security*",
            "acme-logistics-dev-logs-windows.sysmon_operational-*",
            "acme-logistics-dev-winlogbeat-*"
        ],
        "interval": "60m",
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Acme Logistics (Development): Binary Content Copy via Cmd.exe",
        "query": "process where host.os.type == \"windows\" and event.type == \"start\" and\n  process.name : \"cmd.exe\" and (\n    (process.args : \"type\" and process.args : (\">\", \">>\")) or\n    (process.args : \"copy\" and process.args : \"/b\"))\n",
        "related_integrations": [
            {
                "package": "endpoint",
                "version": ">=9.0.0"
            },
            {
                "package": "windows",
                "version": ">=3.0.0"
            },
            {
                "package": "system",
                "version": ">=2.0.0"
            }
        ],
        "required_fields": [
            {
                "ecs": true,
                "name": "event.type",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "host.os.type",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "process.args",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "process.name",
                "type": "keyword"
            }
        ],
        "risk_score": 21,
        "rule_id": "c3a91070-2bef-56ec-b2d2-3f60a3340f51",
        "severity": "low",
        "tags": [
            "Domain: Endpoint",
            "OS: Windows",
            "Use Case: Threat Detection",
            "Tactic: Execution",
            "Data Source: Elastic Defend",
            "Rule Type: BBR",
            "Data Source: Sysmon",
            "Data Source: Elastic Endgame",
            "Data Source: Windows Security Event Logs",
            "Rule Type: Event Correlation (EQL)",
            "Platform: Windows",
            "Tactic: Stealth",
            "Acme Business Unit: Logistics",
            "Acme Environment: Development",
            "Source: Acme Rules Library"
        ],
        "threat": [
            {
                "framework": "MITRE ATT&CK",
                "tactic": {
                    "id": "TA0005",
                    "name": "Stealth",
                    "reference": "https://attack.mitre.org/tactics/TA0005/"
                },
                "technique": [
                    {
                        "id": "T1027",
                        "name": "Obfuscated Files or Information",
                        "reference": "https://attack.mitre.org/techniques/T1027/"
                    },
                    {
