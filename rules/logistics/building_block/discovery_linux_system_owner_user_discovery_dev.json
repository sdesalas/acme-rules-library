{
    "attributes": {
        "author": [
            "Acme Security Engineering"
        ],
        "building_block_type": "default",
        "description": "Identifies the use of built-in tools which adversaries may use to enumerate the system owner/user of a compromised system. Tuned for the Acme Logistics development environment.",
        "from": "now-119m",
        "history_window_start": "now-5d",
        "index": [
            "acme-logistics-dev-logs-endpoint.events.*",
            "acme-logistics-dev-endgame-*",
            "acme-logistics-dev-logs-sentinel_one_cloud_funnel.*"
        ],
        "interval": "60m",
        "language": "kuery",
        "license": "Elastic License v2",
        "name": "Acme Logistics (Development): System Owner/User Discovery Linux",
        "new_terms_fields": [
            "process.parent.executable",
            "process.command_line",
            "host.id"
        ],
        "query": "event.category:process and host.os.type:linux and event.type:start and event.action:(exec or exec_event or start) and\nprocess.name:(\"whoami\" or \"w\" or \"who\" or \"users\" or \"id\" or \"groups\")\n",
        "related_integrations": [
            {
                "package": "endpoint",
                "version": ">=9.0.0"
            },
            {
                "package": "sentinel_one_cloud_funnel",
                "version": ">=1.9.0"
            }
        ],
        "required_fields": [
            {
                "ecs": true,
                "name": "event.action",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "event.category",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "event.type",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "host.os.type",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "process.name",
                "type": "keyword"
            }
        ],
        "risk_score": 21,
        "rule_id": "8c38e243-11f4-573b-a640-c5bc1b6e95cb",
        "severity": "low",
        "tags": [
            "Domain: Endpoint",
            "OS: Linux",
            "Use Case: Threat Detection",
            "Tactic: Discovery",
            "Rule Type: BBR",
            "Data Source: Elastic Defend",
            "Data Source: Elastic Endgame",
            "Data Source: SentinelOne",
            "Rule Type: New Terms",
            "Platform: Linux",
            "Acme Business Unit: Logistics",
            "Acme Environment: Development",
            "Source: Acme Rules Library"
        ],
        "threat": [
            {
                "framework": "MITRE ATT&CK",
                "tactic": {
                    "id": "TA0007",
                    "name": "Discovery",
                    "reference": "https://attack.mitre.org/tactics/TA0007/"
                },
                "technique": [
                    {
                        "id": "T1033",
                        "name": "System Owner/User Discovery",
                        "reference": "https://attack.mitre.org/techniques/T1033/"
                    },
                    {
                        "id": "T1069",
                        "name": "Permission Groups Discovery",
                        "reference": "https://attack.mitre.org/techniques/T1069/"
                    }
                ]
            }
        ],
        "timestamp_override": "event.ingested",
        "type": "new_terms",
        "version": 1
    },
    "id": "8c38e243-11f4-573b-a640-c5bc1b6e95cb_1",
    "type": "security-rule"
}