{
    "attributes": {
        "author": [
            "Acme Security Engineering"
        ],
        "building_block_type": "default",
        "description": "InstallUtil is a command-line utility that allows for installation and uninstallation of resources by executing specific installer components specified in .NET binaries. Adversaries may use InstallUtil to proxy the execution of code through a trusted Windows utility. Tuned for the Acme Logistics staging environment.",
        "from": "now-119m",
        "index": [
            "acme-logistics-staging-endgame-*",
            "acme-logistics-staging-logs-endpoint.events.process-*",
            "acme-logistics-staging-logs-system.security*",
            "acme-logistics-staging-logs-windows.*",
            "acme-logistics-staging-winlogbeat-*"
        ],
        "interval": "60m",
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Acme Logistics (Staging): InstallUtil Activity",
        "query": "process where host.os.type == \"windows\" and event.type == \"start\" and\n  process.name : \"installutil.exe\" and not user.id : \"S-1-5-18\"\n",
        "related_integrations": [
            {
                "package": "endpoint",
                "version": ">=9.0.0"
            },
            {
                "package": "windows",
                "version": ">=3.0.0"
            },
            {
                "package": "system",
                "version": ">=2.0.0"
            }
        ],
        "required_fields": [
            {
                "ecs": true,
                "name": "event.type",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "host.os.type",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "process.name",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "user.id",
                "type": "keyword"
            }
        ],
        "risk_score": 21,
        "rule_id": "9c6aecf9-dbd4-50a1-bdb6-fc7a329ce591",
        "severity": "low",
        "tags": [
