{
    "attributes": {
        "author": [
            "Acme Security Engineering"
        ],
        "building_block_type": "default",
        "description": "Detects a new IP address used for a GitHub user not previously seen in the last 14 days. Tuned for the Acme Logistics production environment.",
        "from": "now-9m",
        "history_window_start": "now-5d",
        "index": [
            "acme-logistics-prod-logs-github.audit-*"
        ],
        "language": "kuery",
        "license": "Elastic License v2",
        "name": "Acme Logistics (Production): First Occurrence of IP Address For GitHub User",
        "new_terms_fields": [
            "user.name",
            "github.actor_ip"
        ],
        "query": "event.dataset:\"github.audit\" and event.category:\"configuration\" and\ngithub.actor_ip:* and user.name:*\n",
        "related_integrations": [
            {
                "package": "github",
                "version": ">=3.0.0"
            }
        ],
        "required_fields": [
            {
                "ecs": true,
                "name": "event.category",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "event.dataset",
                "type": "keyword"
            },
            {
                "ecs": false,
                "name": "github.actor_ip",
                "type": "ip"
            },
            {
                "ecs": true,
                "name": "user.name",
                "type": "keyword"
            }
        ],
        "risk_score": 21,
        "rule_id": "b833ae31-f4f7-51ff-9fa0-2cdb84efcd4c",
        "severity": "low",
        "tags": [
            "Domain: Cloud",
            "Use Case: Threat Detection",
            "Use Case: UEBA",
            "Tactic: Initial Access",
            "Rule Type: BBR",
            "Data Source: Github",
            "Rule Type: New Terms",
            "Platform: GitHub",
            "Domain: SaaS",
            "Acme Business Unit: Logistics",
            "Acme Environment: Production",
            "Source: Acme Rules Library"
        ],
        "threat": [
            {
                "framework": "MITRE ATT&CK",
                "tactic": {
                    "id": "TA0001",
                    "name": "Initial Access",
                    "reference": "https://attack.mitre.org/tactics/TA0001/"
                },
                "technique": [
                    {
                        "id": "T1078",
                        "name": "Valid Accounts",
                        "reference": "https://attack.mitre.org/techniques/T1078/",
                        "subtechnique": [
                            {
                                "id": "T1078.004",
                                "name": "Cloud Accounts",
                                "reference": "https://attack.mitre.org/techniques/T1078/004/"
                            }
                        ]
                    }
                ]
            }
        ],
        "timestamp_override": "event.ingested",
        "type": "new_terms",
        "version": 1
    },
    "id": "b833ae31-f4f7-51ff-9fa0-2cdb84efcd4c_1",
    "type": "security-rule"
}