{
    "attributes": {
        "author": [
            "Acme Security Engineering"
        ],
        "building_block_type": "default",
        "description": "This rule detects the execution of kubectl commands that are commonly used for configuration discovery in Kubernetes environments. It looks for process events where kubectl is executed with arguments that query configuration information, such as configmaps. In environments where kubectl is not expected to be used, this could indicate potential reconnaissance activity by an adversary. Tuned for the Acme Research staging environment.",
        "from": "now-119m",
        "index": [
            "acme-research-staging-logs-endpoint.events.*",
            "acme-research-staging-endgame-*",
            "acme-research-staging-auditbeat-*",
            "acme-research-staging-logs-auditd_manager.auditd-*",
            "acme-research-staging-logs-crowdstrike.fdr*",
            "acme-research-staging-logs-cloud_defend.process*"
        ],
        "interval": "60m",
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Acme Research (Staging): Kubectl Configuration Discovery",
        "query": "process where host.os.type == \"linux\" and event.type == \"start\" and\nevent.action in (\"exec\", \"exec_event\", \"executed\", \"process_started\", \"ProcessRollup2\") and\nprocess.name == \"kubectl\" and process.args in (\"get\", \"describe\") and process.args in (\"configmap\", \"configmaps\") and\nnot (\n  ?process.parent.args in (\n    \"/hooks/schedule_sync_configmap.sh\", \"/service-fabric/generate-support-bundle.sh\", \"/hooks/onstartup_sync_configmap.sh\"\n  ) and\n  ?process.parent.args != null\n)\n",
        "related_integrations": [
            {
                "package": "endpoint",
                "version": ">=9.0.0"
            },
            {
                "package": "auditd_manager",
                "version": ">=1.18.0"
            },
            {
                "package": "crowdstrike",
                "version": ">=3.0.0"
            },
            {
                "package": "cloud_defend",
                "version": ">=1.4.0"
            }
        ],
        "required_fields": [
            {
                "ecs": true,
                "name": "event.action",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "event.type",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "host.os.type",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "process.args",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "process.name",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "process.parent.args",
                "type": "keyword"
            }
        ],
        "risk_score": 21,
        "rule_id": "54c47a5b-612e-5eed-80c5-1c887aeecb5a",
        "severity": "low",
        "tags": [
            "Domain: Containers",
            "Domain: Endpoint",
            "Domain: Kubernetes",
            "OS: Linux",
            "Use Case: Threat Detection",
            "Tactic: Discovery",
            "Rule Type: BBR",
            "Data Source: Elastic Defend",
            "Data Source: Elastic Endgame",
            "Data Source: Auditd Manager",
            "Data Source: Crowdstrike",
            "Data Source: Elastic Defend for Containers",
            "Rule Type: Event Correlation (EQL)",
            "Platform: Linux",
            "Platform: Kubernetes",
            "Acme Business Unit: Research",
            "Acme Environment: Staging",
            "Source: Acme Rules Library"
        ],
        "threat": [
            {
                "framework": "MITRE ATT&CK",
                "tactic": {
                    "id": "TA0007",
                    "name": "Discovery",
                    "reference": "https://attack.mitre.org/tactics/TA0007/"
                },
                "technique": [
                    {
                        "id": "T1613",
                        "name": "Container and Resource Discovery",
                        "reference": "https://attack.mitre.org/techniques/T1613/"
                    }
                ]
            }
        ],
        "timestamp_override": "event.ingested",
        "type": "eql",
        "version": 1
    },
    "id": "54c47a5b-612e-5eed-80c5-1c887aeecb5a_1",
    "type": "security-rule"
}