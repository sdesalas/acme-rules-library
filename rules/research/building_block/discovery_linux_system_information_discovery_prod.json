{
    "attributes": {
        "author": [
            "Acme Security Engineering"
        ],
        "building_block_type": "default",
        "description": "This rule identifies Linux system information discovery activity via built-in commands that read common system files. Adversaries may use these commands to gather information about the operating system, installed services, and hardware configuration to aid in further exploration and exploitation of the system. Tuned for the Acme Research production environment.",
        "from": "now-119m",
        "history_window_start": "now-5d",
        "index": [
            "acme-research-prod-logs-endpoint.events.*",
            "acme-research-prod-endgame-*",
            "acme-research-prod-logs-sentinel_one_cloud_funnel.*"
        ],
        "interval": "60m",
        "language": "kuery",
        "license": "Elastic License v2",
        "name": "Acme Research (Production): Linux System Information Discovery",
        "new_terms_fields": [
            "process.parent.executable",
            "process.command_line",
            "host.id"
        ],
        "query": "event.category:process and host.os.type:linux and event.type:start and event.action:(exec or exec_event or start) and\nprocess.name:(\"cat\" or \"more\" or \"less\" or \"nano\" or \"vi\" or \"vim\" or \"vim.basic\" or \"emacs\") and\nprocess.args:(\n  \"/etc/issue\" or \"/etc/os-release\" or \"/proc/version\" or \"/etc/profile\" or \"/proc/cpuinfo\" or \"/etc/services\" or\n  \"/etc/lsb-release\" or \"/etc/redhat-release\" or \"/etc/debian_version\" or \"/etc/hostname\"\n) and\nnot process.parent.executable:(\"/usr/local/jamf/bin/jamf\" or \"/etc/cp/watchdog/cp-nano-watchdog\")\n",
        "related_integrations": [
            {
                "package": "endpoint",
                "version": ">=9.0.0"
            },
            {
                "package": "sentinel_one_cloud_funnel",
                "version": ">=1.9.0"
            }
        ],
        "required_fields": [
            {
                "ecs": true,
                "name": "event.action",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "event.category",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "event.type",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "host.os.type",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "process.args",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "process.name",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "process.parent.executable",
                "type": "keyword"
            }
        ],
        "risk_score": 21,
        "rule_id": "c902f479-8b26-581d-92db-bdfdcc4ed0bb",
        "severity": "low",
        "tags": [
            "Domain: Endpoint",
            "OS: Linux",
            "Use Case: Threat Detection",
            "Tactic: Discovery",
            "Rule Type: BBR",
            "Data Source: Elastic Defend",
            "Data Source: Elastic Endgame",
            "Data Source: SentinelOne",
            "Rule Type: New Terms",
            "Platform: Linux",
            "Acme Business Unit: Research",
            "Acme Environment: Production",
            "Source: Acme Rules Library"
        ],
        "threat": [
            {
                "framework": "MITRE ATT&CK",
                "tactic": {
                    "id": "TA0007",
                    "name": "Discovery",
                    "reference": "https://attack.mitre.org/tactics/TA0007/"
                },
                "technique": [
                    {
                        "id": "T1082",
                        "name": "System Information Discovery",
                        "reference": "https://attack.mitre.org/techniques/T1082/"
                    }
                ]
            }
        ],
        "timestamp_override": "event.ingested",
        "type": "new_terms",
        "version": 1
    },
    "id": "c902f479-8b26-581d-92db-bdfdcc4ed0bb_1",
    "type": "security-rule"
}