        ],
        "building_block_type": "default",
        "description": "Access to private GitHub organization resources was revoked for a PAT. Tuned for the Acme Research staging environment.",
        "from": "now-9m",
        "index": [
            "acme-research-staging-logs-github.audit-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Acme Research (Staging): GitHub PAT Access Revoked",
        "query": "configuration where event.dataset == \"github.audit\" and event.action == \"personal_access_token.access_revoked\"\n",
        "related_integrations": [
            {
                "package": "github",
                "version": ">=3.0.0"
            }
        ],
        "required_fields": [
