{
    "attributes": {
        "author": [
            "Acme Security Engineering"
        ],
        "building_block_type": "default",
        "description": "Identifies attempts to modify a service path setting using sc.exe. Attackers may attempt to modify existing services for persistence or privilege escalation. Tuned for the Acme Manufacturing production environment.",
        "from": "now-119m",
        "index": [
            "acme-manufacturing-prod-endgame-*",
            "acme-manufacturing-prod-logs-endpoint.events.process-*",
            "acme-manufacturing-prod-logs-system.security*",
            "acme-manufacturing-prod-logs-windows.sysmon_operational-*",
            "acme-manufacturing-prod-winlogbeat-*"
        ],
        "interval": "60m",
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Acme Manufacturing (Production): Service Path Modification via sc.exe",
        "query": "process where event.type == \"start\" and process.name : \"sc.exe\" and\n  process.args : \"*config*\" and process.args : \"*binPath*\"\n",
        "related_integrations": [
            {
                "package": "endpoint",
                "version": ">=9.0.0"
            },
            {
                "package": "windows",
                "version": ">=3.0.0"
            },
            {
                "package": "system",
                "version": ">=2.0.0"
            }
        ],
        "required_fields": [
            {
                "ecs": true,
                "name": "event.type",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "process.args",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "process.name",
                "type": "keyword"
            }
        ],
        "risk_score": 21,
        "rule_id": "ac9c51bc-263c-5b64-a69b-75dbb37c7d37",
        "severity": "low",
