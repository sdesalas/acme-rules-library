{
    "attributes": {
        "author": [
            "Acme Security Engineering"
        ],
        "building_block_type": "default",
        "description": "Identifies attempts to modify a service path by an unusual process. Attackers may attempt to modify existing services for persistence or privilege escalation. Tuned for the Acme Manufacturing staging environment.",
        "from": "now-119m",
        "index": [
            "acme-manufacturing-staging-logs-endpoint.events.registry-*",
            "acme-manufacturing-staging-endgame-*",
            "acme-manufacturing-staging-logs-windows.sysmon_operational-*",
            "acme-manufacturing-staging-winlogbeat-*"
        ],
        "interval": "60m",
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Acme Manufacturing (Staging): Service Path Modification",
        "query": "registry where host.os.type == \"windows\" and event.type == \"change\" and\n  registry.path : (\n    \"HKLM\\\\SYSTEM\\\\*ControlSet*\\\\Services\\\\*\\\\ImagePath\",\n    \"\\\\REGISTRY\\\\MACHINE\\\\SYSTEM\\\\*ControlSet*\\\\Services\\\\*\\\\ImagePath\"\n  ) and not (\n    process.executable : (\n      \"?:\\\\Program Files\\\\*.exe\",\n      \"?:\\\\Program Files (x86)\\\\*.exe\",\n      \"?:\\\\Windows\\\\System32\\\\services.exe\",\n      \"?:\\\\Windows\\\\WinSxS\\\\*\"\n    )\n  )\n",
        "related_integrations": [
            {
                "package": "endpoint",
                "version": ">=9.0.0"
            },
            {
                "package": "windows",
                "version": ">=3.0.0"
            }
        ],
        "required_fields": [
            {
                "ecs": true,
                "name": "event.type",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "host.os.type",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "process.executable",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "registry.path",
                "type": "keyword"
            }
        ],
        "risk_score": 21,
        "rule_id": "a5a3d954-382d-52da-a4db-f00f45005264",
        "severity": "low",
        "tags": [
            "Domain: Endpoint",
            "OS: Windows",
            "Use Case: Threat Detection",
            "Data Source: Elastic Endgame",
            "Data Source: Elastic Defend",
            "Rule Type: BBR",
            "Data Source: Sysmon",
            "Rule Type: Event Correlation (EQL)",
            "Platform: Windows",
            "Tactic: Defense Impairment",
            "Tactic: Persistence",
            "Tactic: Privilege Escalation",
            "Acme Business Unit: Manufacturing",
            "Acme Environment: Staging",
            "Source: Acme Rules Library"
        ],
        "threat": [
