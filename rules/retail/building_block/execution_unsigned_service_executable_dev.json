{
    "attributes": {
        "author": [
            "Acme Security Engineering"
        ],
        "building_block_type": "default",
        "description": "This rule identifies the execution of unsigned executables via service control manager (SCM). Adversaries may abuse SCM to execute malware or escalate privileges. Tuned for the Acme Retail development environment.",
        "from": "now-9m",
        "history_window_start": "now-5d",
        "index": [
            "acme-retail-dev-logs-endpoint.events.process-*"
        ],
        "language": "kuery",
        "license": "Elastic License v2",
        "name": "Acme Retail (Development): Execution of an Unsigned Service",
        "new_terms_fields": [
            "host.id",
            "process.executable",
            "user.id"
        ],
        "query": "host.os.type:windows and event.category:process and event.type:start and \nprocess.parent.executable:\"C:\\\\Windows\\\\System32\\\\services.exe\" and \n(process.code_signature.exists:false or process.code_signature.trusted:false) and\nnot process.code_signature.status : (errorCode_endpoint* or \"errorChaining\")\n",
        "related_integrations": [
            {
                "package": "endpoint",
                "version": ">=9.0.0"
            }
        ],
        "required_fields": [
            {
                "ecs": true,
                "name": "event.category",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "event.type",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "host.os.type",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "process.code_signature.exists",
                "type": "boolean"
            },
            {
                "ecs": true,
                "name": "process.code_signature.status",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "process.code_signature.trusted",
                "type": "boolean"
            },
            {
                "ecs": true,
                "name": "process.parent.executable",
                "type": "keyword"
            }
        ],
        "risk_score": 21,
        "rule_id": "35e458c0-c4e2-57bf-939b-12ae8a5591d1",
        "severity": "low",
        "tags": [
