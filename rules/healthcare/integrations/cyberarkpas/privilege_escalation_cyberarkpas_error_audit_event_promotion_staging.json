                "type": "constant_keyword"
            },
            {
                "ecs": true,
                "name": "event.type",
                "type": "keyword"
            }
        ],
        "risk_score": 73,
        "rule_id": "47c38db8-f5cc-5ba7-b525-3cef8a41fa0e",
