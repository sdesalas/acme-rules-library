        "description": "Identifies the occurrence of a CyberArk Privileged Access Security (PAS) error level audit event. The event.code correlates to the CyberArk Vault Audit Action Code. Tuned for the Acme Healthcare staging environment.",
        "false_positives": [
            "To tune this rule, add exceptions to exclude any event.code which should not trigger this rule."
        ],
        "from": "now-30m",
        "index": [
            "acme-healthcare-staging-filebeat-*",
            "acme-healthcare-staging-logs-cyberarkpas.audit*"
        ],
        "language": "kuery",
        "license": "Elastic License v2",
        "name": "Acme Healthcare (Staging): CyberArk Privileged Access Security Error",
        "note": "## Triage and analysis\n\nThis is a promotion rule for CyberArk error events, which are alertable events per the vendor.\nConsult vendor documentation on interpreting specific events.",
        "query": "data_stream.dataset:cyberarkpas.audit and event.type:error\n",
        "references": [
            "https://docs.cyberark.com/Product-Doc/OnlineHelp/PAS/Latest/en/Content/PASREF/Vault%20Audit%20Action%20Codes.htm?tocpath=Administration%7CReferences%7C_____3"
