{
    "attributes": {
        "author": [
            "Acme Security Engineering"
        ],
        "building_block_type": "default",
        "description": "Identifies administrative actions in the Microsoft 365 Security & Compliance Center including cmdlet execution, RBAC changes, security insights, and user permission modifications. These events can indicate legitimate administrative activity or potential defense evasion through security control modifications such as DLP policy removal, compliance rule changes, or privilege escalation. This building block rule generates security events for correlation, threat hunting, and telemetry collection. Tuned for the Acme Healthcare development environment.",
        "from": "now-9m",
        "index": [
            "acme-healthcare-dev-logs-o365.audit-*",
            "acme-healthcare-dev-filebeat-*"
        ],
        "language": "kuery",
        "license": "Elastic License v2",
        "name": "Acme Healthcare (Development): M365 Security Compliance Admin Signal",
        "query": "event.dataset:o365.audit and\n    event.code:(SecurityComplianceCenterEOPCmdlet or SecurityComplianceInsights or SecurityComplianceRBAC or SecurityComplianceUserChange)\n",
        "references": [
            "https://learn.microsoft.com/en-us/purview/audit-log-activities",
            "https://learn.microsoft.com/en-us/office/office-365-management-api/office-365-management-activity-api-schema#enum-auditlogrecordtype---type-edmint32"
        ],
        "related_integrations": [
            {
                "package": "o365",
                "version": ">=3.0.0"
            }
        ],
        "required_fields": [
            {
                "ecs": true,
                "name": "event.code",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "event.dataset",
                "type": "keyword"
            }
        ],
        "risk_score": 21,
        "rule_id": "6b5cf6d0-e2e0-5f11-baa8-000190de985c",
        "setup": "### Additional notes\n\nFor information on troubleshooting the maximum alerts warning please refer to this [guide](https://www.elastic.co/guide/en/security/current/alerts-ui-monitor.html#troubleshoot-max-alerts).\n",
