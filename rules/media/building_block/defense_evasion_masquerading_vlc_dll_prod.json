{
    "attributes": {
        "author": [
            "Acme Security Engineering"
        ],
        "building_block_type": "default",
        "description": "Identifies instances of VLC-related DLLs which are not signed by the original developer. Attackers may name their payload as legitimate applications to blend into the environment, or embedding its malicious code within legitimate applications to deceive machine learning algorithms by incorporating authentic and benign code. Tuned for the Acme Media production environment.",
        "from": "now-9m",
        "index": [
            "acme-media-prod-logs-endpoint.events.library-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Acme Media (Production): Potential Masquerading as VLC DLL",
        "query": "library where host.os.type == \"windows\" and event.action == \"load\" and\n  dll.name : (\"libvlc.dll\", \"libvlccore.dll\", \"axvlc.dll\") and\n  not (\n    dll.code_signature.subject_name : (\"VideoLAN\", \"716F2E5E-A03A-486B-BC67-9B18474B9D51\")\n    and dll.code_signature.trusted == true\n  )\n",
        "related_integrations": [
            {
                "package": "endpoint",
                "version": ">=9.0.0"
            }
        ],
        "required_fields": [
            {
                "ecs": true,
                "name": "dll.code_signature.subject_name",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "dll.code_signature.trusted",
                "type": "boolean"
            },
            {
                "ecs": true,
                "name": "dll.name",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "event.action",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "host.os.type",
                "type": "keyword"
            }
        ],
        "risk_score": 21,
        "rule_id": "c91da3c0-2f54-5f5c-a3ce-b57d176e2cd5",
        "severity": "low",
        "tags": [
            "Domain: Endpoint",
            "Data Source: Elastic Defend",
            "OS: Windows",
            "Use Case: Threat Detection",
            "Tactic: Persistence",
            "Rule Type: BBR",
            "Rule Type: Event Correlation (EQL)",
            "Platform: Windows",
            "Tactic: Stealth",
            "Acme Business Unit: Media",
            "Acme Environment: Production",
            "Source: Acme Rules Library"
        ],
        "threat": [
            {
