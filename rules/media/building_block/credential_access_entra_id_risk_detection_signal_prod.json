        "index": [
            "acme-media-prod-logs-o365.audit-*",
            "acme-media-prod-filebeat-*"
        ],
        "language": "kuery",
        "license": "Elastic License v2",
        "name": "Acme Media (Production): M365 Entra ID Risk Detection Signal",
        "query": "event.dataset:o365.audit and event.code:AadRiskDetection\n",
        "references": [
            "https://learn.microsoft.com/en-us/entra/id-protection/concept-identity-protection-risks",
