{
    "attributes": {
        "author": [
            "Acme Security Engineering"
        ],
        "building_block_type": "default",
        "description": "The Microsoft Connection Manager Profile Installer (CMSTP.exe) is a command-line program to install Connection Manager service profiles, which accept installation information file (INF) files. Adversaries may abuse CMSTP to proxy the execution of malicious code by supplying INF files that contain malicious commands. Tuned for the Acme Media staging environment.",
        "from": "now-9m",
        "index": [
            "acme-media-staging-endgame-*",
            "acme-media-staging-logs-endpoint.events.process-*",
            "acme-media-staging-logs-system.security*",
            "acme-media-staging-logs-windows.sysmon_operational-*",
            "acme-media-staging-winlogbeat-*"
        ],
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Acme Media (Staging): Potential Defense Evasion via CMSTP.exe",
        "query": "process where host.os.type == \"windows\" and event.type == \"start\" and\n  process.name : \"cmstp.exe\" and process.args == \"/s\"\n",
        "references": [
            "https://attack.mitre.org/techniques/T1218/003/"
        ],
        "related_integrations": [
            {
                "package": "endpoint",
                "version": ">=9.0.0"
            },
            {
                "package": "windows",
                "version": ">=3.0.0"
            },
            {
                "package": "system",
                "version": ">=2.0.0"
            }
        ],
        "required_fields": [
            {
                "ecs": true,
                "name": "event.type",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "host.os.type",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "process.args",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "process.name",
                "type": "keyword"
            }
        ],
