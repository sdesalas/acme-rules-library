{
    "attributes": {
        "author": [
            "Acme Security Engineering"
        ],
        "building_block_type": "default",
        "description": "Identifies files written to the root of the Recycle Bin folder instead of subdirectories. Adversaries may place files in the root of the Recycle Bin in preparation for exfiltration or to evade defenses. Tuned for the Acme Media staging environment.",
        "from": "now-119m",
        "index": [
            "acme-media-staging-logs-endpoint.events.file-*",
            "acme-media-staging-logs-windows.sysmon_operational-*",
            "acme-media-staging-endgame-*",
            "acme-media-staging-winlogbeat-*"
        ],
        "interval": "60m",
        "language": "eql",
        "license": "Elastic License v2",
        "name": "Acme Media (Staging): File Staged in Root Folder of Recycle Bin",
        "query": "file where host.os.type == \"windows\" and event.type == \"creation\" and\n  file.path : \"?:\\\\$RECYCLE.BIN\\\\*\" and\n  not file.path : \"?:\\\\$RECYCLE.BIN\\\\*\\\\*\" and\n  not file.name : \"desktop.ini\"\n",
        "related_integrations": [
            {
                "package": "endpoint",
                "version": ">=9.0.0"
            },
            {
                "package": "windows",
                "version": ">=3.0.0"
            }
        ],
        "required_fields": [
            {
                "ecs": true,
                "name": "event.type",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "file.name",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "file.path",
                "type": "keyword"
            },
            {
                "ecs": true,
                "name": "host.os.type",
                "type": "keyword"
            }
        ],
        "risk_score": 21,
        "rule_id": "869ad2d2-6295-5172-ba9e-67dd2ea70a0b",
        "severity": "low",
        "tags": [
            "Domain: Endpoint",
            "OS: Windows",
            "Use Case: Threat Detection",
            "Tactic: Collection",
            "Data Source: Elastic Defend",
            "Rule Type: BBR",
            "Data Source: Elastic Endgame",
            "Data Source: Sysmon",
            "Rule Type: Event Correlation (EQL)",
            "Platform: Windows",
            "Tactic: Stealth",
            "Acme Business Unit: Media",
            "Acme Environment: Staging",
            "Source: Acme Rules Library"
        ],
        "threat": [
